      spacing="10" style="-fx-padding: 10;">

    <Label text="Barista Order Queue" style="-fx-font-size: 18px;" />

    <ListView fx:id="orderQueueListView" prefHeight="300"/>

    <Button text="Complete Next Order" onAction="#handleCompleteOrder"/>

</VBox>
