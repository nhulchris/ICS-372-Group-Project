<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.brewbite.controller.ManagerController"
            prefWidth="900" prefHeight="640">

    <top>
        <HBox spacing="10" alignment="CENTER_LEFT">
            <padding><Insets top="15" right="15" bottom="10" left="15"/></padding>
            <Label text="Manager Dashboard"
                   style="-fx-font-size: 20px; -fx-font-weight: bold;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="salesLabel" style="-fx-font-size: 14px; -fx-font-weight: bold;"/>
            <Button text="Back" onAction="#handleBack"/>
        </HBox>
    </top>

    <center>
        <TabPane tabClosingPolicy="UNAVAILABLE">

            <!-- INVENTORY TAB -->
            <Tab text="Inventory">
                <VBox spacing="10">
                    <padding><Insets top="15" right="15" bottom="15" left="15"/></padding>

                    <Label text="Current Inventory" style="-fx-font-weight: bold;"/>
                    <TableView fx:id="inventoryTable" prefHeight="320">
                        <columns>
                            <TableColumn fx:id="ingredientColumn" text="Ingredient" prefWidth="300"/>
                            <TableColumn fx:id="stockColumn"      text="Stock"      prefWidth="180"/>
                        </columns>
                    </TableView>

                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <Label text="Restock amount:"/>
                        <TextField fx:id="amountField" prefWidth="120" promptText="e.g. 50"/>
                        <Button text="Restock Selected"  onAction="#handleRestock"/>
                        <Button text="Add New Ingredient" onAction="#handleAddIngredient"/>
                        <TextField fx:id="newIngredientField" prefWidth="160"
                                   promptText="New ingredient name"/>
                    </HBox>
                </VBox>
            </Tab>

            <!-- MENU TAB -->
            <Tab text="Menu Management">
                <HBox spacing="15">
                    <padding><Insets top="15" right="15" bottom="15" left="15"/></padding>

                    <VBox spacing="8" prefWidth="430">
                        <Label text="Current Menu" style="-fx-font-weight: bold;"/>
                        <ListView fx:id="menuListView" prefHeight="380"/>
                        <HBox spacing="10">
                            <Button text="Remove Selected" onAction="#handleRemoveMenuItem"/>
                            <Button text="Modify Selected" onAction="#handleModifyMenuItem"/>
                        </HBox>
                    </VBox>

                    <VBox spacing="8" prefWidth="430">
                        <Label text="Add / Edit Item" style="-fx-font-weight: bold;"/>

                        <Label text="Type:"/>
                        <ComboBox fx:id="itemTypeBox" prefWidth="200"/>

                        <Label text="Name:"/>
                        <TextField fx:id="itemNameField" promptText="e.g. Vanilla Latte"/>

                        <Label text="Base Price:"/>
                        <TextField fx:id="itemPriceField" promptText="e.g. 4.50"/>

                        <Label text="Ingredients (format: name:qty, name:qty)"/>
                        <TextField fx:id="itemIngredientsField"
                                   promptText="e.g. Milk:2, Coffee Beans:1"/>

                        <HBox spacing="10">
                            <Button text="Add Item"   onAction="#handleAddMenuItem"/>
                            <Button text="Clear Form" onAction="#handleClearForm"/>
                        </HBox>
                    </VBox>
                </HBox>
            </Tab>

            <!-- ORDERS TAB -->
            <Tab text="Orders &amp; Sales">
                <VBox spacing="10">
                    <padding><Insets top="15" right="15" bottom="15" left="15"/></padding>

                    <Label text="All Orders (active and historical)"
                           style="-fx-font-weight: bold;"/>
                    <ListView fx:id="orderListView" prefHeight="450"/>
                </VBox>
            </Tab>

        </TabPane>
    </center>

    <bottom>
        <HBox>
            <padding><Insets top="6" right="15" bottom="12" left="15"/></padding>
            <Label fx:id="statusLabel" text="" style="-fx-text-fill: #B00020;"/>
        </HBox>
    </bottom>

</BorderPane>
