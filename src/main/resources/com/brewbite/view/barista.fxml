<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.brewbite.controller.BaristaController"
            prefWidth="800" prefHeight="540">

    <top>
        <HBox spacing="10" alignment="CENTER_LEFT">
            <padding><Insets top="15" right="15" bottom="10" left="15"/></padding>
            <Label text="Barista Dashboard" style="-fx-font-size: 20px; -fx-font-weight: bold;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="Back" onAction="#handleBack"/>
        </HBox>
    </top>

    <center>
        <VBox spacing="10">
            <padding><Insets top="0" right="15" bottom="10" left="15"/></padding>

            <Label text="Pending and In-Progress Orders (FIFO)"
                   style="-fx-font-weight: bold;"/>
            <ListView fx:id="orderListView" prefHeight="270"/>

            <HBox spacing="10">
                <Button text="Start Order"        onAction="#handleStartOrder"/>
                <Button text="Mark Ready"         onAction="#handleMarkReady"/>
                <Button text="Complete Order"     onAction="#handleCompleteOrder"
                        style="-fx-base: #4CAF50;"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="Cancel Order"       onAction="#handleCancelOrder"
                        style="-fx-base: #B00020; -fx-text-fill: white;"/>
            </HBox>

            <Label text="Completed History" style="-fx-font-weight: bold;"/>
            <ListView fx:id="historyListView" prefHeight="120"/>
        </VBox>
    </center>

    <bottom>
        <HBox>
            <padding><Insets top="6" right="15" bottom="12" left="15"/></padding>
            <Label fx:id="statusLabel" text="" style="-fx-text-fill: #B00020;"/>
        </HBox>
    </bottom>

</BorderPane>
