<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.brewbite.controller.CustomerOrderController"
            prefWidth="900" prefHeight="600">

    <top>
        <HBox spacing="10" alignment="CENTER_LEFT">
            <padding><Insets top="15" right="15" bottom="10" left="15"/></padding>
            <Label text="Customer Order" style="-fx-font-size: 20px; -fx-font-weight: bold;" />
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="welcomeLabel" style="-fx-font-size: 14px;"/>
            <Button text="Back" onAction="#handleBack"/>
        </HBox>
    </top>

    <center>
        <HBox spacing="15">
            <padding><Insets top="0" right="15" bottom="10" left="15"/></padding>

            <!-- LEFT: Menu + customization panel -->
            <VBox spacing="8" prefWidth="430">
                <Label text="Menu" style="-fx-font-weight: bold;"/>
                <ListView fx:id="menuListView" prefHeight="200"/>

                <Label text="Options (beverages only)" style="-fx-font-weight: bold;"/>
                <HBox spacing="8" alignment="CENTER_LEFT">
                    <Label text="Size:"/>
                    <ComboBox fx:id="sizeBox" prefWidth="120"/>
                    <Label text="Qty:"/>
                    <TextField fx:id="quantityField" prefWidth="60" text="1"/>
                </HBox>

                <Label text="Customizations:"/>
                <ScrollPane fitToWidth="true" prefHeight="120">
                    <VBox fx:id="customizationsBox" spacing="4">
                        <padding><Insets top="4" right="4" bottom="4" left="4"/></padding>
                    </VBox>
                </ScrollPane>

                <HBox spacing="10">
                    <Button text="Add to Cart" onAction="#handleAddToCart"/>
                </HBox>
            </VBox>

            <!-- RIGHT: Cart -->
            <VBox spacing="8" prefWidth="430">
                <Label text="Cart" style="-fx-font-weight: bold;"/>
                <ListView fx:id="cartListView" prefHeight="380"/>

                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Label fx:id="totalLabel" text="Total: $0.00"
                           style="-fx-font-size: 16px; -fx-font-weight: bold;"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button text="Remove Selected" onAction="#handleRemoveFromCart"/>
                    <Button text="Clear Order" onAction="#handleClearOrder"/>
                </HBox>

                <Button text="Place Order" onAction="#handlePlaceOrder"
                        prefWidth="430" style="-fx-font-size: 14px;"/>
            </VBox>
        </HBox>
    </center>

    <bottom>
        <HBox>
            <padding><Insets top="6" right="15" bottom="12" left="15"/></padding>
            <Label fx:id="statusLabel" text="" style="-fx-text-fill: #B00020;"/>
        </HBox>
    </bottom>

</BorderPane>
